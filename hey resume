# --------------------------------------------------
# EXTRACT SKILLS
# --------------------------------------------------

def extract_skills(text):

    text = text.lower()

    detected = []

    for skill in SKILLS:

        if skill in text:
            detected.append(skill)

    return list(set(detected))


# --------------------------------------------------
# EXTRACT BASIC INFORMATION
# --------------------------------------------------

def extract_name(text):

    lines = [
        line.strip()
        for line in text.split("\n")
        if line.strip()
    ]

    if len(lines) > 0:
        return lines[0]

    return "Candidate"


def extract_education(text):

    education_keywords = [
        "b.tech",
        "btech",
        "b.e",
        "bachelor",
        "degree",
        "m.tech",
        "mtech",
        "mba",
        "b.sc",
        "m.sc"
    ]

    found = []

    for line in text.split("\n"):

        lower_line = line.lower()

        for keyword in education_keywords:

            if keyword in lower_line:
                found.append(line.strip())
                break

    return found[:5]


# --------------------------------------------------
# JOB MATCHING
# --------------------------------------------------

def calculate_match(resume_skills, job):

    required = set(job["required_skills"])
    preferred = set(job["preferred_skills"])
    resume = set(resume_skills)

    matched_required = resume.intersection(required)
    matched_preferred = resume.intersection(preferred)

    missing_required = required - resume

    required_score = 0

    preferred_score = 0

    if required:
        required_score = (
            len(matched_required) / len(required)
        ) * 80

    if preferred:
        preferred_score = (
            len(matched_preferred) / len(preferred)
        ) * 20

    score = round(required_score + preferred_score)

    return {
        "score": score,
        "matched": sorted(
            list(matched_required.union(matched_preferred))
        ),
        "missing": sorted(list(missing_required))
    }


