def generate_roadmap(missing_skills):

    roadmap = []

    skill_groups = {
        "python": "Python fundamentals and object-oriented programming",
        "sql": "SQL and database fundamentals",
        "git": "Git and GitHub",
        "django": "Django web development",
        "rest api": "REST API development",
        "javascript": "JavaScript fundamentals",
        "react": "React.js",
        "html": "HTML fundamentals",
        "css": "CSS and responsive design",
        "java": "Java programming",
        "c": "C programming fundamentals",
        "data structures": "Data Structures",
        "algorithms": "Algorithms",
        "excel": "Advanced Excel",
        "statistics": "Statistics fundamentals",
        "power bi": "Power BI",
        "tableau": "Tableau"
    }

    for skill in missing_skills[:8]:

        if skill in skill_groups:
            roadmap.append(skill_groups[skill])
        else:
            roadmap.append(
                skill.title() + " fundamentals"
            )

    return roadmap


# --------------------------------------------------
# RESUME IMPROVEMENT
# --------------------------------------------------

def resume_suggestions(text, skills):

    suggestions = []

    if len(text) < 500:
        suggestions.append(
            "Your resume appears short. Add relevant projects, "
            "certifications and achievements."
        )

    if "summary" not in text.lower() and "objective" not in text.lower():
        suggestions.append(
            "Consider adding a short professional summary."
        )

    if "project" not in text.lower():
        suggestions.append(
            "Add 2-3 academic or personal projects."
        )

    if "certification" not in text.lower():
        suggestions.append(
            "Add relevant certifications if available."
        )

    if len(skills) < 4:
        suggestions.append(
            "Add relevant technical skills that you actually possess."
        )

    suggestions.append(
        "Use action-oriented words such as developed, designed, "
        "implemented and analyzed when describing your work."
    )

    return suggestions


