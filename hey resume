@app.route("/chat", methods=["POST"])
def chat():

    data = request.get_json()

    question = data.get(
        "question",
        ""
    ).lower()

    skills = data.get(
        "skills",
        []
    )

    jobs_data = data.get(
        "jobs",
        []
    )

    if not question:

        return jsonify({
            "answer": "Please ask me a career-related question."
        })

    if "skill" in question:

        answer = (
            "Based on your resume, your detected skills are: "
            + ", ".join(skills)
            + "."
        )

    elif "job" in question or "career" in question:

        if jobs_data:

            best = jobs_data[0]

            answer = (
                f"Your strongest current match is "
                f"{best['title']} at {best['company']} "
                f"with a match score of {best['score']}%."
            )

        else:

            answer = (
                "Upload your resume first so I can recommend "
                "suitable jobs."
            )

    elif "learn" in question:

        if jobs_data:

            missing = jobs_data[0]["missing"]

            if missing:

                roadmap = generate_roadmap(missing)

                answer = (
                    "You should focus on these skills next: "
                    + ", ".join(roadmap)
                )

            else:

                answer = (
                    "Your profile already matches the major "
                    "requirements of your top job."
                )

        else:

            answer = "Upload your resume first."

    elif "resume" in question:

        answer = (
            "Improve your resume by highlighting relevant "
            "skills, projects, certifications and measurable "
            "achievements. Keep the content truthful and "
            "ATS-friendly."
        )

    else:

        answer = (
            "I can help you with job matching, skill gaps, "
            "resume improvement and learning recommendations."
        )

    return jsonify({
        "answer": answer
    })


